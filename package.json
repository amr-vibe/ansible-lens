{
  "name": "ansible-lens-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "Ansible Lens — Zero-dependency, cross-platform, static-metadata Ansible Language Server & VS Code Extension. Ansible Lens is an independent, community-built extension and is not affiliated with or endorsed by Red Hat, Inc. Ansible® is a registered trademark of Red Hat, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amr-vibe/ansible-lens.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "scripts/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml}\"",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "package:vsix": "npm --workspace=packages/client run package:vsix",
    "prepare": "husky || true",
    "test:e2e": "npm --workspace=packages/client run test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8",
    "yaml": "^2.6.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.1": true
  }
}
